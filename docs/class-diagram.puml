@startuml WashTrack_Bounded_Contexts_Overview
title WashTrack - Bounded Contexts Overview (Domain Layer)
hide methods
hide attributes
skinparam packageStyle rectangle

package "Shared Kernel" {
  package "Domain" {
    abstract class AggregateRoot {
      #id: uuid
    }
    interface Repository<T> {
      +findById(id: uuid): T
      +save(entity: T): T
      +update(entity: T): T
      +delete(id: uuid)
    }
    class DomainEvent <<value object>> {
      -eventId: uuid
      -occurredAt: timestamp
    }
    class Money <<value object>> {
      -amount: decimal
      -currency: string
    }
  }
  package "Infrastructure" {
    abstract class BaseRepository<T> <<repository>> {
      +findById(id: uuid): T
      +save(entity: T): T
      +update(entity: T): T
      +delete(id: uuid)
    }
    BaseRepository ..|> Repository
  }
}

package "Identity & Access" {
  class User <<aggregate root>>
}

package "Customer & Business Management" {
  class Customer <<aggregate root>>
  class Laundry <<aggregate root>>
}

package "Order Management" {
  class Order <<aggregate root>>
  class GarmentItem <<entity>>
}

package "Laundry Operations" {
  class LaundryOrder <<aggregate root>>
  class WashingCycle <<entity>>
  class LaundryResource <<aggregate root>>
}

package "Subscription & Payment" {
  class Payment <<aggregate root>>
  class Subscription <<aggregate root>>
  class SubscriptionPlan <<aggregate root>>
}

package "Tracking & Notifications" {
  class Notification <<aggregate root>>
  class Tracking <<aggregate root>>
  class StatusHistory <<entity>>
}

AggregateRoot <|.. User
AggregateRoot <|.. Customer
AggregateRoot <|.. Laundry
AggregateRoot <|.. Order
AggregateRoot <|.. LaundryOrder
AggregateRoot <|.. LaundryResource
AggregateRoot <|.. Payment
AggregateRoot <|.. Subscription
AggregateRoot <|.. SubscriptionPlan
AggregateRoot <|.. Notification
AggregateRoot <|.. Tracking

Order "1" *-- "1..*" GarmentItem : contains
Tracking "1" *-- "0..*" StatusHistory : contains
SubscriptionPlan "1" <-- "0..*" Subscription : planId

Order ..> Customer : customerId
Order ..> Laundry : laundryId
LaundryOrder ..> Order : orderId
LaundryOrder ..> WashingCycle : washingCycleId
LaundryOrder ..> LaundryResource : resourceId
Payment ..> Customer : customerId
Payment ..> Order : orderId
Subscription ..> Customer : customerId
Notification ..> User : recipientId
Notification ..> Order : orderId
Tracking ..> Order : orderId
Customer ..> User : userId

note right of AggregateRoot
  Todos los aggregate roots extienden
  AggregateRoot del Shared Kernel.
  Las referencias entre bounded contexts
  se realizan mediante identificadores.
end note
@enduml

@startuml WashTrack_Identity_Access_Frontend
title WashTrack - Identity & Access Frontend Model
skinparam packageStyle rectangle

package "Identity & Access Bounded Context" {
  package "Presentation" {
    package "Components" {
      class AuthenticationSection <<component>> {
        -router: Router
        -store: IamStore
        -signOut: function
        -isSignedIn: computed
        -currentUsername: computed
        +performSignIn()
        +performSignUp()
        +performSignOut()
      }
    }
    package "Views" {
      class SignUpForm <<component>> {
        -router: Router
        -store: IamStore
        -signUp: function
        -form: object
        +performSignUp()
      }
      class SignInForm <<component>> {
        -router: Router
        -store: IamStore
        -signIn: function
        -form: object
        +performSignIn()
      }
    }
  }

  package "Application" {
    class IamStore <<store>> {
      -users: User[]
      -errors: any[]
      -usersLoaded: boolean
      -isSignedIn: boolean
      -currentUsername: string|null
      -currentUserId: number|null
      -currentRole: UserRole|null
      +currentToken: computed
      +signIn(signInCommand, router)
      +signUp(signUpCommand, router)
      +signOut()
      +fetchUsers()
      +hasAccess(requiredRole): boolean
    }
  }

  package "Domain" {
    class SignUpCommand <<command>> {
      -username: string
      -email: string
      -password: string
      -role: UserRole
      +constructor(username, email, password, role)
    }
    class SignInCommand <<command>> {
      -username: string
      -password: string
      +constructor(username, password)
    }
    class User <<entity>> {
      -id: string|number
      -username: string
      -email: string
      -role: UserRole
      +constructor(id, username, email, role)
      +hasRole(role): boolean
    }
    enum UserRole {
      FARMER
      OPERATOR
      TECHNICIAN
    }
    User --> UserRole : has
  }

  package "Infrastructure" {
    class iamInterceptor <<interceptor>> {
      +iamInterceptor(config): AxiosRequestConfig
    }
    class roleGuard <<guard>> {
      +roleGuard(to, from): object|boolean
    }
    class authenticationGuard <<guard>> {
      +authenticationGuard(to, from): object|boolean
    }
    class UserAssembler <<assembler>> {
      +toEntityFromResource(resource): User
      +toEntitiesFromResponse(response): User[]
    }
    class SignInAssembler <<assembler>> {
      +toResourceFromResponse(response): SignInResource
    }
    class SignUpAssembler <<assembler>> {
      +toResourceFromResponse(response): SignUpResource
    }
    class IamApi {
      -signInEndpoint: BaseEndpoint
      -signUpEndpoint: BaseEndpoint
      -usersEndpoint: BaseEndpoint
      +constructor()
      +signIn(signInRequest): Promise
      +signUp(signUpRequest): Promise
      +getUsers(): Promise
      +updateUserRole(id, role): Promise
    }
    class SignUpResource <<resource>> {
      -message: string
      +constructor(message)
    }
    class SignInResource <<resource>> {
      -id: string|number
      -username: string
      -role: string
      -token: string
      +constructor(id, username, role, token)
    }
  }
}

package "Shared Bounded Context" {
  class BaseApi
  class BaseEndpoint
}

AuthenticationSection --> IamStore
SignUpForm --> IamStore
SignUpForm --> SignUpCommand
SignInForm --> IamStore
SignInForm --> SignInCommand
IamStore --> IamApi
IamStore --> UserAssembler
IamStore --> SignInAssembler
IamStore --> SignUpAssembler
iamInterceptor --> IamStore
roleGuard --> IamStore
authenticationGuard --> IamStore
IamApi --> BaseEndpoint
IamApi ..|> BaseApi
SignInAssembler ..> SignInResource
SignUpAssembler ..> SignUpResource
UserAssembler ..> User
@enduml

