@startuml WashTrack_Laundry_Operations
title WashTrack - Laundry Operations Bounded Context
skinparam packageStyle rectangle

package "Laundry Operations Bounded Context" {
  package "Presentation" {
    class LaundryOperationsController <<controller>> {
      +receiveOrder(request)
      +classifyOrder(request)
      +assignCycle(request)
      +assignResource(request)
      +advanceStage(request)
    }
    class LaundryDashboard <<component>> {
      -laundryOrders: LaundryOrder[]
      +displayOrders()
      +updateStage(orderId, stage)
      +prioritizeOrder(orderId)
    }
  }
  package "Application" {
    class LaundryOperationService <<service>> {
      +receiveOrder(orderId): LaundryOrder
      +classifyOrder(orderId)
      +assignWashingCycle(orderId, cycleId)
      +assignResource(orderId, resourceId)
      +advanceStage(orderId, stage)
      +prioritizeOrder(orderId)
    }
    class ResourceService <<service>> {
      +getAvailableResources(laundryId): LaundryResource[]
      +assignResource(resourceId)
      +releaseResource(resourceId)
    }
  }
  package "Domain" {
    class LaundryOrder <<aggregate root>> {
      -id: uuid
      -orderId: uuid
      -currentStage: ProcessingStage
      -priority: Priority
      -washingCycleId: uuid
      -resourceId: uuid
      -expectedCompletion: timestamp
      +advanceStage(stage)
      +assignResource(resourceId)
      +assignWashingCycle(cycleId)
    }
    class WashingCycle <<entity>> {
      -id: uuid
      -name: string
      -durationMinutes: int
      -compatibleType: string
      +constructor(id, name, durationMinutes, compatibleType)
    }
    class LaundryResource <<aggregate root>> {
      -id: uuid
      -laundryId: uuid
      -name: string
      -status: ResourceStatus
      -capacity: int
      +assign()
      +release()
    }
    enum Priority {
      NORMAL
      VIP
    }
    enum ProcessingStage {
      RECEPTION
      CLASSIFICATION
      WASHING
      DRYING_IRONING
      PACKAGING
      READY
    }
    enum ResourceStatus {
      AVAILABLE
      BUSY
      MAINTENANCE
    }
    interface WashingCycleRepository <<repository>> {
      +findCompatible(type): WashingCycle[]
    }
    interface ResourceRepository <<repository>> {
      +findAvailable(laundryId): LaundryResource[]
    }
    interface LaundryOperationRepository <<repository>> {
      +findByOrderId(orderId): LaundryOrder
    }
  }
  package "Infrastructure" {
    class WashingCycleRepositoryImpl <<adapter>>
    class ResourceRepositoryImpl <<adapter>>
    class LaundryOperationRepositoryImpl <<adapter>>
    class ResourceMonitoringACL <<anti-corruption layer>> {
      -iotGateway: IoTGatewayAPI
      +getResourceStatus(deviceId): ResourceStatus
      +translate(payload: SensorTelemetryPayload): ResourceStatus
    }
  }
}

package "External IoT Gateway" {
