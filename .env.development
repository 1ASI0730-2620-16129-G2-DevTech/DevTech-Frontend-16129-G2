# Environment: Production
# Description: Environment variables for production environment
# Note: Do not commit sensitive information to version control

# VITE_WASHTRACK_PLATFORM_API_URL is the base URL of the REST API (json-server mock runs on port 3000, see server/start.sh).
VITE_WASHTRACK_PLATFORM_API_URL="https://washtrack-fake-api.onrender.com/api/v1"

# Endpoint paths of each bounded context are added below by the team, e.g.:
# VITE_ORDERS_ENDPOINT_PATH="/orders"
# Order Management uses its own mock collection (UUID ids, OrderStatus values).
VITE_ORDERS_ENDPOINT_PATH="/customer-orders"
VITE_ORDER_CUSTOMERS_ENDPOINT_PATH="/customer-profiles"
VITE_CUSTOMERS_ENDPOINT_PATH="/customer-profiles"
VITE_SERVICES_ENDPOINT_PATH="/services"
VITE_GARMENTS_ENDPOINT_PATH="/garments"
VITE_USERS_ENDPOINT_PATH="/users"
VITE_PAYMENTS_ENDPOINT_PATH="/payments"

# VITE_TRACKINGS_ENDPOINT_PATH is the path to the tracking endpoint.
VITE_TRACKING_ENDPOINT_PATH="/trackings"

# VITE_NOTIFICATIONS_ENDPOINT_PATH is the path to the notifications endpoint.
VITE_NOTIFICATIONS_ENDPOINT_PATH="/notifications"

# VITE_DELIVERIES_ENDPOINT_PATH is the Path to the pickups and deliveries endpoint.
VITE_DELIVERIES_ENDPOINT_PATH="/deliveries"

# VITE_PRIME_UI_LICENSE_KEY is the license key for the Prime UI library.
VITE_PRIME_UI_LICENSE_KEY="eyJpZCI6ImQ1YzRhODEzLTVhYzYtNDRhMC1hZDdjLTIwMjM3ZWMzY2E4MyIsInByb2R1Y3QiOiJwcmltZXVpIiwidGllciI6ImNvbW11bml0eSIsInR5cGUiOiJkZXYiLCJpYXQiOjE3ODk1NzE3OTAsImV4cCI6MTgyMTEwNzc5MH0.47AJrUa_b4etpgo5bHdRNoJxDGXB7OiqbY4_Y5XT3Nn6gDGboOys8MJI6xKMqz68VP2UIREkn7vclECz_HcaDw"

# How often (in milliseconds) the app looks for new notifications.
VITE_NOTIFICATIONS_POLLING_INTERVAL="10000"

# How long (in milliseconds) a notification stays on screen before closing by itself.
VITE_NOTIFICATIONS_TOAST_LIFETIME="8000"

# Laundry Operations endpoints
VITE_LAUNDRY_ORDERS_ENDPOINT_PATH="/laundryOrders"
VITE_WASHING_CYCLES_ENDPOINT_PATH="/washingCycles"
VITE_LAUNDRY_RESOURCES_ENDPOINT_PATH="/laundryResources"

# IoT gateway (sensor telemetry read by the laundry-operations anti-corruption layer)
VITE_IOT_GATEWAY_API_URL="https://washtrack-fake-api.onrender.com/api/v1"
VITE_IOT_SENSOR_DATA_ENDPOINT_PATH="/sensorData"
