# Environment: Production
# Description: Environment variables for production environment
# Note: Do not commit sensitive information to version control

# VITE_WASHTRACK_PLATFORM_API_URL is the base URL of the REST API (json-server mock runs on port 3000, see server/start.sh).
VITE_WASHTRACK_PLATFORM_API_URL="http://localhost:3000/api/v1"

# Endpoint paths of each bounded context are added below by the team, e.g.:
# VITE_ORDERS_ENDPOINT_PATH="/orders"

# VITE_TRACKINGS_ENDPOINT_PATH is the path to the tracking endpoint.
VITE_TRACKING_ENDPOINT_PATH="/trackings"

# VITE_DELIVERIES_ENDPOINT_PATH is the Path to the pickups and deliveries endpoint.
VITE_DELIVERIES_ENDPOINT_PATH="/deliveries"

# VITE_PRIME_UI_LICENSE_KEY is the license key for the Prime UI library.
VITE_PRIME_UI_LICENSE_KEY=""

# How often (in milliseconds) the app looks for new notifications.
VITE_NOTIFICATIONS_POLLING_INTERVAL="10000"

# How long (in milliseconds) a notification stays on screen before closing by itself.
VITE_NOTIFICATIONS_TOAST_LIFETIME="8000"

# Laundry Operations endpoints
VITE_LAUNDRY_ORDERS_ENDPOINT_PATH="/laundryOrders"
VITE_WASHING_CYCLES_ENDPOINT_PATH="/washingCycles"
VITE_LAUNDRY_RESOURCES_ENDPOINT_PATH="/laundryResources"